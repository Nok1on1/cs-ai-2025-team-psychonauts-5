{
  "name": "grade_test",
  "description": "Grade a submitted test and return detailed results.",
  "parameters": {
    "type": "object",
    "properties": {
      "test_session_id": {"type": "integer"},
      "answers": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "question_index": {"type": "integer", "minimum": 0},
            "selected_answer_id": {"type": "string", "pattern": "^[A-D]$"},
            "time_spent_seconds": {"type": "integer", "minimum": 0}
          },
          "required": ["question_index", "selected_answer_id", "time_spent_seconds"]
        },
        "minItems": 1
      }
    },
    "required": ["test_session_id", "answers"]
  }
}
