{
  "name": "generate_test",
  "description": "Generate an adaptive test session given the TestGenerationRequest.",
  "parameters": {
    "type": "object",
    "properties": {
      "subject": {"type": "string", "enum": ["math", "logic"]},
      "target_difficulty": {"type": "integer", "minimum": 1, "maximum": 5},
      "num_questions": {"type": "integer", "minimum": 5, "maximum": 20},
      "focus_topics": {
        "type": "array",
        "items": {"type": "string"}
      },
      "exclude_question_ids": {
        "type": "array",
        "items": {"type": "integer"}
      }
    },
    "required": ["subject", "target_difficulty"]
  }
}
