{
  "name": "generate_socratic_feedback",
  "description": "Generate Socratic feedback and hints for a wrong answer.",
  "parameters": {
    "type": "object",
    "properties": {
      "question_text": {"type": "string"},
      "correct_answer_id": {"type": "string", "pattern": "^[A-D]$"},
      "student_answer_id": {"type": "string", "pattern": "^[A-D]$"},
      "topic_tags": {
        "type": "array",
        "items": {"type": "string"}
      }
    },
    "required": ["question_text", "correct_answer_id", "student_answer_id", "topic_tags"]
  }
}
