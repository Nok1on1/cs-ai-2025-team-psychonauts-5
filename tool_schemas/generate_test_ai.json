{
  "name": "generate_test_ai",
  "description": "Generate a test session with AI-synthesized questions for a given subject and difficulty.",
  "parameters": {
    "type": "object",
    "properties": {
      "subject": {"type": "string", "enum": ["math", "logic"]},
      "difficulty": {"type": "integer", "minimum": 1, "maximum": 3},
      "num_questions": {"type": "integer", "minimum": 1, "maximum": 20}
    },
    "required": ["subject"],
    "additionalProperties": false
  }
}
